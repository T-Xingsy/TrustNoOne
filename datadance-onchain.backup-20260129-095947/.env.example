# BSN-DDC SDK Configuration
# Copy this file to .env and fill in your actual values

# Required: BSN-DDC Gateway URL
# Obtain from: https://ddc.bsnbase.com
BSN_DDC_GATEWAY_URL=https://your-gateway-url-here

# Required: BSN-DDC API Key
# Find in: BSN-DDC Portal > Business Information
BSN_DDC_API_KEY=your-api-key-here

# Optional: Target blockchain (default: taianchain)
# Options: taianchain, wuhanchain, wenchangchain, zhongyichain
BSN_DDC_CHAIN=taianchain

# Optional: Enable debug logging
DEBUG=false

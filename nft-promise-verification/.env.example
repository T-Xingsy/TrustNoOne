# ==================== LLM 配置 ====================
# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic API Key (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ==================== Spoon-Toolkit API 配置 ====================
# Chainbase API Key (用于链上数据查询)
# 获取地址: https://chainbase.com
CHAINBASE_API_KEY=your-chainbase-api-key-here

# GitHub Token (用于开发力审计)
# 获取地址: https://github.com/settings/tokens
GITHUB_TOKEN=ghp-your-github-token-here

# Bitquery API Key (用于代币持有者数据，可选)
# 获取地址: https://bitquery.io
BITQUERY_API_KEY=your-bitquery-api-key-here

# ==================== Etherscan API 配置 ====================
# Etherscan API Key (用于链上数据查询、事件日志查询 - 模块4核心功能)
# 获取地址: https://etherscan.io/myapikey
# 免费额度: 5次/秒
ETHERSCAN_API_KEY=your-etherscan-api-key-here

# Polygonscan API Key (可选，用于 Polygon 链)
POLYGONSCAN_API_KEY=your-polygonscan-api-key-here

# Arbiscan API Key (可选，用于 Arbitrum 链)
ARBISCAN_API_KEY=your-arbiscan-api-key-here

# Optimism API Key (可选，用于 Optimism 链)
OPTIMISM_API_KEY=your-optimism-api-key-here

# Basescan API Key (可选，用于 Base 链)
BASESCAN_API_KEY=your-basescan-api-key-here

# ==================== OpenSea API 配置 ====================
# OpenSea API Key (用于 NFT 集合数据)
# 获取地址: https://docs.opensea.io/reference/api-overview
OPENSEA_API_KEY=your-opensea-api-key-here

# ==================== RPC 节点配置 ====================
# Ethereum Mainnet RPC
ETH_MAINNET_RPC=https://eth-mainnet.g.alchemy.com/v2/your-alchemy-key

# Ethereum Sepolia Testnet RPC
ETH_SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/your-alchemy-key

# ==================== 其他配置 ====================
# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 数据库路径
DATABASE_PATH=data/verification.db

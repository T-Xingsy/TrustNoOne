# ============================================
# NFT Promise Verification System - 环境变量配置模板
# ============================================

# -------------------- LLM 配置 --------------------
# Claude API (优先使用)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (备用)
OPENAI_API_KEY=your_openai_api_key_here

# LLM 模型选择 (claude-3-5-sonnet-20241022 | gpt-4-turbo)
LLM_MODEL=claude-3-5-sonnet-20241022

# -------------------- 区块链配置 --------------------
# Ethereum Mainnet RPC
ETH_MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Sepolia Testnet RPC
ETH_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# 备用 RPC 提供商 (Alchemy)
ETH_MAINNET_RPC_URL_BACKUP=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ETH_SEPOLIA_RPC_URL_BACKUP=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# -------------------- DDC-Market-SDK 配置 --------------------
# BSN-DDC 网关地址
BSN_DDC_GATEWAY_URL=https://opbningxia.bsngate.com:18602/api/[project_id]/rpc

# BSN-DDC API 密钥
BSN_DDC_API_KEY=your_bsn_ddc_api_key_here

# -------------------- 数据收集配置 --------------------
# Twitter API (如果使用官方 API)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# GitHub API Token (用于开发力审计)
GITHUB_TOKEN=your_github_token_here

# -------------------- 数据库配置 --------------------
# SQLite 数据库路径
DATABASE_PATH=./database/promise_breaker.db

# -------------------- 日志配置 --------------------
# 日志级别 (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# 日志输出格式 (json | console)
LOG_FORMAT=json

# 日志文件路径
LOG_FILE_PATH=./logs/promise_breaker.log

# -------------------- API 服务配置 --------------------
# FastAPI 服务端口
API_PORT=8000

# API 服务主机
API_HOST=0.0.0.0

# CORS 允许的源 (逗号分隔)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -------------------- 性能配置 --------------------
# 并发验证任务数量
MAX_CONCURRENT_VERIFICATIONS=10

# RPC 请求超时时间 (秒)
RPC_TIMEOUT=30

# LLM 请求超时时间 (秒)
LLM_TIMEOUT=60

# -------------------- 开发配置 --------------------
# 开发模式 (true | false)
DEV_MODE=true

# 是否启用调试日志
DEBUG=false
